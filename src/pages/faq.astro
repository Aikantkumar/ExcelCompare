---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    question: "How to compare two columns in excel",
    answer: "Use the Compare Columns tool. Select the column from File 1 and File 2, then run the comparison. The engine computes set intersection, unique left values, and unique right values, with instant CSV download of matching and non-matching rows."
  },
  {
    question: "How to compare two excel sheets",
    answer: "Upload both files into File 1 and File 2 in the File Comparison mode. The engine parses all worksheets locally using Web Workers and presents a side-by-side view with synchronized scrolling. Modified cells render in soft amber, added rows in emerald green, deleted rows in rose red, and formula changes in deep indigo."
  },
  {
    question: "How to compare two lists in excel",
    answer: "Use Compare Columns mode for list-based comparison. Pick the column from each file containing your lists (e.g. email subscriber lists, part numbers, or product SKUs). The tool computes intersection, unique left values, and unique right values instantly."
  },
  {
    question: "How to compare two excel sheets for differences and matches",
    answer: "Use File Comparison mode. Drop both sheets into File 1 and File 2. The comparison engine highlights cell-level differences and matches side-by-side. Click “Export Diff” to generate a high-density, printable HTML report summarizing all differences and matches."
  },
  {
    question: "How can I match two columns and output a third column?",
    answer: "Use Reconciliation Mode. Pick the Primary Key column (e.g. Account Code or SKU) from both files and the Value column to compare. Records are matched by key ID across both sheets. Export the reconciled result as CSV to output matched values into a third column."
  },
  {
    question: "How do I compare two sets of data?",
    answer: "Choose the comparison mode that fits your data: File Comparison for full sheet diffs, Compare Columns for two-list set operations, or Reconciliation for ID-based matching across unordered rows. All processing happens locally in your browser — no files are uploaded to a server."
  }
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": answer
    }
  }))
}, null, 2);
---

<Layout
  title="Excel Compare FAQ — Compare Columns, Sheets & Lists"
  description="Frequently asked questions about comparing Excel spreadsheets, columns, sheets, and lists. Learn how to compare two columns, compare two excel sheets, match lists, and find differences and matches with CompareExcel."
  keywords="excel compare faq, how to compare two columns in excel, how to compare two excel sheets, how to compare two lists in excel, compare excel sheets differences matches, match two columns output third column, compare two sets of data"
  ogImage="/og-image.png"
>
  <div class="py-16 bg-[#000000] border-b border-[#262626]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-4">
        <div class="text-caption text-[#c3d9f3]">FREQUENTLY ASKED QUESTIONS</div>
        <h1 class="text-display-lg text-white">COMMON QUESTIONS ABOUT EXCEL COMPARISON</h1>
        <a href="/" class="inline-block px-6 py-3 border border-[#ffffff] text-[#ffffff] rounded-full text-mono text-xs tracking-widest uppercase hover:bg-[#ffffff] hover:text-[#000000] transition-colors">START COMPARING</a>
      </div>

      <div class="space-y-6 font-serif text-[#cccccc] leading-relaxed">
        {faqs.map(({ question, answer }) => (
          <div class="border border-[#262626] bg-[#0d0d0d] p-8 space-y-4">
            <h2 class="text-title-md text-white font-mono">{question}</h2>
            <p>{answer}</p>
          </div>
        ))}
      </div>

      <div class="text-center">
        <p class="text-caption text-[#c3d9f3]">NEED MORE HELP?</p>
        <p class="text-title-sm text-white">Start a new comparison at CompareExcel — all processing runs locally in your browser.</p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={faqJsonLd} />
</Layout>
