---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/pages/AboutSection.astro';
import { t } from '../utils/translations';
import { defaultLocale, type Locale } from '../config';

const lang = defaultLocale;
const title = t(lang, 'pages.about.title', "About CompareExcel — High-Precision Client-Side Spreadsheet Diff Engine");
const description = t(lang, 'pages.about.description', "Learn about CompareExcel: a client-side spreadsheet comparison tool for diffing Excel files, columns, sheets, and lists with zero server uploads, formula inspection, and full privacy.");
const keywords = t(lang, 'pages.about.keywords', "about compareexcel, excel compare, spreadsheet diff, client-side comparison, compareexcel team");

---

<Layout
  lang={lang}
  title={title}
  description={description}
  keywords={keywords}
  ogImage="/og-image.png"
>
  <AboutSection lang={lang} />
</Layout>
