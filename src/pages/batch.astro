---
import Layout from '../layouts/Layout.astro';
import CompareToolContainer from '../components/comparison/CompareToolContainer.jsx';
import { defaultLocale } from '../config';

const lang = defaultLocale;
---

<Layout
  lang={lang}
  title="Batch Excel Compare Multiple Files — Queue Processing Tool"
  description="Batch excel compare multiple file pairs at once. Queue spreadsheets and generate consolidated audit reports. 100% private client-side batch diff engine."
  keywords="excel compare two files, excel compare, online excel compare, excel compare two sheets, batch excel compare"
  ogImage="/og-image.png"
>
  <div class="py-8 bg-canvas">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
      <div class="text-caption text-link">MODE 04</div>
      <h1 class="text-display-md text-ink">BATCH COMPARISON QUEUE</h1>
      <p class="font-serif text-muted text-base mt-1">
        Queue and execute multiple spreadsheet comparisons simultaneously.
      </p>
    </div>

    <CompareToolContainer client:only="react" initialMode="batch" />
  </div>
</Layout>
