---
import Layout from '../layouts/Layout.astro';
import { defaultLocale } from '../config';

const lang = defaultLocale;
---

<Layout
  lang={lang}
  title="ExcelCompareColumns Privacy — 100% Client-Side Browser Processing"
  description="ExcelCompareColumns privacy guarantee: all excel compare columns, sheets, and files processing runs 100% locally in your browser. Zero server uploads."
  keywords="excel compare columns, excel compare, excel compare two files, online excel compare, excel compare privacy"
  ogImage="/og-image.png"
>
  <div class="py-16 bg-canvas border-b border-hairline">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-4">
        <div class="text-caption text-success">100% LOCAL BROWSER DIFF GUARANTEE</div>
        <h1 class="text-display-lg text-ink">YOUR SPREADSHEET DATA NEVER LEAVES YOUR DEVICE</h1>
      </div>

      <div class="border border-hairline bg-surface-soft p-8 space-y-6 font-serif text-body leading-relaxed">
        <h2 class="text-title-md text-ink font-mono">ZERO SERVER UPLOAD ARCHITECTURE</h2>
        <p>
          At ExcelCompareColumns, we understand that financial reports, payroll sheets, supplier pricing lists, and audit files contain private, highly sensitive business data.
        </p>
        <p>
          Unlike legacy cloud diff services that require uploading your `.xlsx` files to a remote server, ExcelCompareColumns performs <strong>100% of its parsing, diff calculation, set matching, and report rendering locally inside your web browser</strong> using JavaScript Web Workers and SheetJS.
        </p>

        <h2 class="text-title-md text-white font-mono">TECHNICAL VERIFICATION</h2>
        <ul class="list-disc pl-6 space-y-2 font-mono text-xs text-muted">
          <li>Open Network DevTools: No HTTP POST or file upload requests occur when loading or diffing spreadsheets.</li>
          <li>Works Offline: Once the page is loaded, you can disconnect your internet entirely and continue diffing files offline.</li>
          <li>No Third-Party Data Selling or Analytics on Spreadsheet Contents.</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
