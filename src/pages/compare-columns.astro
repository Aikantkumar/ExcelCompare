---
import Layout from '../layouts/Layout.astro';
import CompareToolContainer from '../components/comparison/CompareToolContainer.jsx';
---

<Layout
  title="Compare Two Columns — Excel List Set Comparison Tool"
  description="Compare two Excel or CSV columns instantly to find common intersection items, unique left values, and unique right values."
>
  <div class="py-8 bg-[#000000]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
      <div class="text-caption text-[#c3d9f3]">MODE 02</div>
      <h1 class="text-display-md text-white">COLUMN SET COMPARISON TOOL</h1>
      <p class="font-serif text-[#999999] text-base mt-1">
        Mathematical set operations for list columns: Intersection, Unique Left, and Unique Right values.
      </p>
    </div>

    <CompareToolContainer client:load initialMode="columns" />
  </div>
</Layout>
