---
import Layout from '../layouts/Layout.astro';
import CompareToolContainer from '../components/comparison/CompareToolContainer.jsx';
import { defaultLocale } from '../config';

const lang = defaultLocale;
---

<Layout
  lang={lang}
  title="Excel Compare Two Columns — Set Match & Difference Tool"
  description="Compare two Excel columns online. Find matches, differences, intersection, and unique values for excel compare two columns for matches and differences. 100% private client-side processing."
  keywords="excel compare columns, excel compare two columns, excel compare two columns for matches, excel compare two columns for differences, excel compare two lists, online excel compare"
  ogImage="/og-image.png"
>
  <div class="py-8 bg-canvas">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
      <div class="text-caption text-link">MODE 02</div>
      <h1 class="text-display-md text-ink">COLUMN SET COMPARISON TOOL</h1>
      <p class="font-serif text-muted text-base mt-1">
        Mathematical set operations for list columns: Intersection, Unique Left, and Unique Right values.
      </p>
    </div>

    <CompareToolContainer client:only="react" initialMode="columns" />
  </div>
</Layout>
