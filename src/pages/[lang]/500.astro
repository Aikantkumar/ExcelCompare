---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../utils/translations';
import { locales, defaultLocale, type Locale } from '../../config';
import { localizeHref } from '../../utils/links';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params;
const localeLang = (lang ?? defaultLocale) as Locale;
const title = t(localeLang, 'pages.error500.title', "Server Error — CompareExcel");
const description = t(localeLang, 'pages.error500.description', "Something went wrong on our end. Please try again or return to CompareExcel to compare spreadsheets online.");
const keywords = t(localeLang, 'pages.error500.keywords', "compareexcel, server error, 500, excel compare");
const heading = t(localeLang, 'pages.error500.heading', "500");
const message = t(localeLang, 'pages.error500.message', "We're sorry, but something went wrong on our end. Please try refreshing the page.");
const button = t(localeLang, 'pages.error500.button', "TRY AGAIN");
---

<Layout
  lang={localeLang}
  title={title}
  description={description}
  keywords={keywords}
  ogImage="/og-image.png"
  robots="noindex"
>
  <div class="py-24 bg-canvas border-b border-hairline">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-4">
        <div class="text-caption text-muted">SERVER ERROR</div>
        <h1 class="text-display-xl text-ink">{heading}</h1>
        <p class="font-serif text-muted max-w-2xl mx-auto">{message}</p>
      </div>
      <div class="text-center">
        <a
          href={localizeHref(localeLang, '/compare')}
          class="inline-block px-6 py-3 border border-ink text-ink rounded-full text-mono text-xs tracking-widest uppercase hover:bg-ink hover:text-canvas transition-colors"
        >
          {button}
        </a>
      </div>
    </div>
  </div>
</Layout>
