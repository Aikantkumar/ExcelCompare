---
import Layout from '../../layouts/Layout.astro';
import HelpSection from '../../components/pages/HelpSection.astro';
import { t } from '../../utils/translations';
import { locales, defaultLocale, type Locale } from '../../config';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params;
const localeLang = (lang ?? defaultLocale) as Locale;
const title = t(localeLang, 'pages.help.title', "Excel Compare Help — How to Compare Columns, Sheets & Files");
const description = t(localeLang, 'pages.help.description', "Learn how to excel compare columns, sheets, files, dates, and lists with CompareExcel. Step-by-step documentation for online spreadsheet diffing.");
const keywords = t(localeLang, 'pages.help.keywords', "excel compare columns, excel compare two sheets, excel compare two files, excel compare dates, excel compare two lists, online excel compare, excel compare help, documentation");

---

<Layout
  lang={localeLang}
  title={title}
  description={description}
  keywords={keywords}
  ogImage="/og-image.png"
>
  <HelpSection lang={localeLang} />
</Layout>
