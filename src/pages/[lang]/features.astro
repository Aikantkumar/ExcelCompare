---
import Layout from '../../layouts/Layout.astro';
import FeaturesSection from '../../components/pages/FeaturesSection.astro';
import { t } from '../../utils/translations';
import { locales, defaultLocale, type Locale } from '../../config';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params;
const localeLang = (lang ?? defaultLocale) as Locale;
const title = t(localeLang, 'pages.features.title', "CompareExcel Features — Excel Compare Columns & Sheet Diff Matrix");
const description = t(localeLang, 'pages.features.description', "CompareExcel feature matrix: formula inspection, fuzzy row matching, cell annotations, offline diff, and export for excel compare columns, two sheets, two files, dates, and lists.");
const keywords = t(localeLang, 'pages.features.keywords', "excel compare columns, excel compare two sheets, excel compare two files, excel compare dates, excel compare two lists, excel compare, online excel compare, feature matrix");

---

<Layout
  lang={localeLang}
  title={title}
  description={description}
  keywords={keywords}
  ogImage="/og-image.png"
>
  <FeaturesSection lang={localeLang} />
</Layout>
