---
import Layout from '../layouts/Layout.astro';
import CompareToolContainer from '../components/comparison/CompareToolContainer.jsx';
---

<Layout
  title="Visual File Diff — Compare Excel Files Online (Sync Scroll)"
  description="Compare two Excel files with top-bottom stacked view, synchronized scrolling, overlapped/merged view, cell-by-cell diff, formula inspection, and cell annotations."
>
  <div class="py-8 bg-[#000000]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
      <div class="text-caption text-[#c3d9f3]">MODE 01</div>
      <h1 class="text-display-md text-white">VISUAL FILE COMPARISON ENGINE</h1>
      <p class="font-serif text-[#999999] text-base mt-1">
        Top-bottom stacked & side-by-side synchronized scrolling Excel spreadsheet comparison with formula detection, overlapped merge view & annotations.
      </p>
    </div>

    <CompareToolContainer client:only="react" initialMode="stacked" />
  </div>
</Layout>
