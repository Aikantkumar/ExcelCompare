---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CompareExcel — High Precision Online Spreadsheet & Data Comparison",
  description = "Compare Excel spreadsheets (.xlsx, .csv) with full cell-by-cell diff, formula inspection, smart fuzzy row matching, and zero server upload privacy."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-[#000000] text-[#cccccc] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://compareexcel.com/" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#000000] selection:bg-[#c3d9f3] selection:text-[#000000]">
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
