---
import Wordmark from '../shared/Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromPathname } from '../../config';
import { t } from '../../utils/translations';

const pathname = new URL(Astro.request.url).pathname;
const currentLang = getLocaleFromPathname(pathname);

const navItems = [
  { key: 'compareFiles', href: '/compare' },
  { key: 'compareColumns', href: '/compare-columns' },
  { key: 'reconcile', href: '/reconcile' },
  { key: 'batchDiff', href: '/batch' },
  { key: 'features', href: '/features' },
  { key: 'help', href: '/help' },
];
---

<header class="sticky top-0 z-50 bg-canvas/90 backdrop-blur-md border-b border-hairline transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <Wordmark />

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8" aria-label="Main Navigation">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-nav transition-colors ${
              isActive 
                ? 'text-ink border-b border-ink pb-1 font-semibold' 
                : 'text-muted hover:text-ink'
            }`}
          >
            {t(currentLang, `nav.${item.key}`, item.key)}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3 sm:gap-4">
      <ThemeToggle />
      <LanguageSwitcher lang={currentLang} />
      <a href="/compare" class="btn-primary px-3 sm:px-5 text-xs h-9 tracking-[1px] sm:tracking-[2px] min-h-[40px] sm:h-auto sm:min-h-auto">
        {t(currentLang, 'nav.launchTool', 'LAUNCH TOOL')}
      </a>
    </div>
  </div>

  <!-- Mobile Sub-nav -->
  <div class="md:hidden flex items-center gap-2 border-t border-hairline bg-surface-soft px-2 py-2 overflow-x-auto scrollbar-hide text-[11px] font-mono tracking-wider text-body whitespace-nowrap">
    <a href="/compare" class={pathname === '/compare' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'nav.compareFiles', 'FILES')}</a>
    <a href="/compare-columns" class={pathname === '/compare-columns' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'nav.compareColumns', 'COLUMNS')}</a>
    <a href="/reconcile" class={pathname === '/reconcile' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'nav.reconcile', 'RECONCILE')}</a>
    <a href="/batch" class={pathname === '/batch' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'nav.batchDiff', 'BATCH')}</a>
    <a href="/features" class={pathname === '/features' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'nav.features', 'FEATURES')}</a>
    <a href="/help" class={pathname === '/help' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'nav.help', 'HELP')}</a>
    <a href="/faq" class={pathname === '/faq' ? 'text-ink font-bold underline' : 'hover:text-ink'} style="white-space: nowrap">{t(currentLang, 'common.faq', 'FAQ')}</a>
  </div>
</header>
