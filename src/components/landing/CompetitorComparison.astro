---
import { t } from '../../utils/translations';
import { translations, type Locale } from '../../utils/translations';

interface Props {
  lang?: Locale;
}

const { lang: propLang = 'en' } = Astro.props;
const lang = propLang as Locale;

const matrix = (((translations[lang] as any)?.competitor?.rows) as Array<Array<string>>) ?? [];
---

<section class="py-24 bg-surface-soft border-b border-hairline">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-4 mb-16">
      <div class="text-caption text-link">{t(lang, 'competitor.matrixHeading', 'COMPETITIVE MATRIX')}</div>
      <h2 class="text-display-lg">{t(lang, 'competitor.title', 'WHY COMPAREEXCEL OUTPERFORMS GENERIC DIFF TOOLS')}</h2>
      <p class="font-serif text-lg text-muted max-w-2xl mx-auto">
        {t(lang, 'competitor.desc', 'Designed from the ground up to solve the core limitations of standard online spreadsheet diffing.')}
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="border border-hairline bg-canvas overflow-x-auto relative">
      <table class="w-full text-xs font-mono border-collapse" style="min-width: 720px">
        <thead>
          <tr class="bg-surface-card border-b border-hairline text-ink">
            <th class="py-4 px-6 text-left text-title-sm font-normal">{t(lang, 'competitor.colFeature', 'FEATURE & CAPABILITY')}</th>
            <th class="py-4 px-6 text-center text-title-sm font-normal text-muted">{t(lang, 'competitor.colGeneric', 'GENERIC TOOLS (e.g. excelcompare.org)')}</th>
            <th class="py-4 px-6 text-center text-title-sm font-normal text-link bg-diff-formula-bg/40 border-x border-diff-formula-border">
              {t(lang, 'competitor.colCompareExcel', 'COMPAREEXCEL.COM (OUR ADVANTAGE)')}
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body">
          {matrix.map((row) => (
            <tr class="hover:bg-surface-elevated/50">
              <td class="py-4 px-6 font-semibold text-ink">{row[0]}</td>
              <td class="py-4 px-6 text-center text-diff-deleted-text">❌ {row[1]}</td>
              <td class="py-4 px-6 text-center text-diff-added-text bg-diff-formula-bg/20 font-bold border-x border-diff-formula-border/50">
                ✓ {row[2]}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <!-- Scroll hint: fade edge indicating horizontal scrollability -->
      <div class="pointer-events-none absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-canvas/80 via-canvas/40 to-transparent" aria-hidden="true" />
    </div>
  </div>
</section>
