---
---

<section class="py-24 bg-[#0d0d0d] border-b border-[#262626]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-4 mb-16">
      <div class="text-caption text-[#c3d9f3]">COMPETITIVE MATRIX</div>
      <h2 class="text-display-lg">WHY COMPAREEXCEL OUTPERFORMS GENERIC DIFF TOOLS</h2>
      <p class="font-serif text-lg text-[#999999] max-w-2xl mx-auto">
        Designed from the ground up to solve the core limitations of standard online spreadsheet diffing.
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="border border-[#262626] bg-[#000000] overflow-x-auto relative">
      <table class="w-full text-xs font-mono border-collapse" style="min-width: 720px">
        <thead>
          <tr class="bg-[#141414] border-b border-[#262626] text-white">
            <th class="py-4 px-6 text-left text-title-sm font-normal">FEATURE & CAPABILITY</th>
            <th class="py-4 px-6 text-center text-title-sm font-normal text-[#999999]">GENERIC TOOLS (e.g. excelcompare.org)</th>
            <th class="py-4 px-6 text-center text-title-sm font-normal text-[#c3d9f3] bg-[#1e1b4b]/40 border-x border-[#4338ca]">
              COMPAREEXCEL.COM (OUR ADVANTAGE)
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#262626] text-[#cccccc]">
          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Formula Difference Inspection</td>
            <td class="py-4 px-6 text-center text-[#fca5a5]">❌ Displayed values only</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Compares underlying Excel formulas (`=SUM`, `=VLOOKUP`)
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Smart Fuzzy Row Alignment</td>
            <td class="py-4 px-6 text-center text-[#fca5a5]">❌ Strict line offset (fails on inserted rows)</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Content-hash & fuzzy matching for reordered rows
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Cell Annotations & Audit Flags</td>
            <td class="py-4 px-6 text-center text-[#fca5a5]">❌ No note taking or annotation support</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Click any cell to add notes & export with diff
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Export & Report Formats</td>
            <td class="py-4 px-6 text-center text-[#fca5a5]">❌ Minimal CSV export</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Printable PDF, HTML Audit Reports, CSV, Share Links
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Multiple Visual Diff Views</td>
            <td class="py-4 px-6 text-center text-[#999999]">Side-by-side only</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Side-by-Side, Overlay (Before→After), Unified Git Diff
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Batch Multi-Pair Comparison</td>
            <td class="py-4 px-6 text-center text-[#fca5a5]">❌ Single file pair at a time</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Queue multiple pairs in automated batch run
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Embeddable Web Component</td>
            <td class="py-4 px-6 text-center text-[#fca5a5]">❌ No integration API</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ <code>&lt;compare-excel&gt;</code> web component for dashboards
            </td>
          </tr>

          <tr class="hover:bg-[#1f1f1f]/50">
            <td class="py-4 px-6 font-semibold text-white">Design & Typography System</td>
            <td class="py-4 px-6 text-center text-[#999999]">Generic bright template</td>
            <td class="py-4 px-6 text-center text-[#6ee7b7] bg-[#1e1b4b]/20 font-bold border-x border-[#4338ca]/50">
              ✓ Luxury dark theme (Saira Condensed & Cormorant Garamond)
            </td>
          </tr>
        </tbody>
      </table>
      <!-- Scroll hint: fade edge indicating horizontal scrollability -->
      <div class="pointer-events-none absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-[#000000]/80 via-[#000000]/40 to-transparent" aria-hidden="true" />
    </div>
  </div>
</section>
