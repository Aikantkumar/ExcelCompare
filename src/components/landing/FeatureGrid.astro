---
---

<section class="py-24 bg-[#000000] border-b border-[#262626]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-4 mb-16">
      <div class="text-caption text-[#c3d9f3]">ARCHITECTURE & MODES</div>
      <h2 class="text-display-lg">FOUR MODES FOR EVERY SPREADSHEET WORKFLOW</h2>
      <p class="font-serif text-lg text-[#999999] max-w-2xl mx-auto">
        Tailored algorithms built specifically for financial audits, inventory reconciliation, list set logic, and batch processing.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Mode 1: Compare Files -->
      <div class="card-bugatti bg-[#0d0d0d] space-y-6">
        <div class="flex items-center justify-between border-b border-[#262626] pb-4">
          <span class="text-caption text-[#c3d9f3]">MODE 01</span>
          <span class="text-xs font-mono text-[#5fa657]">★ FEATURED</span>
        </div>
        <h3 class="text-display-sm text-white">VISUAL FILE DIFF & SYNC SCROLL</h3>
        <p class="font-serif text-[#cccccc] text-base leading-relaxed">
          Full sheet comparison with lockstep synchronized scrolling. Detect modified cells, inserted rows, deleted rows, and altered formulas with dark-tailored high-visibility diff highlights.
        </p>
        <ul class="space-y-2 font-mono text-xs text-[#999999]">
          <li class="flex items-center gap-2">✓ Side-by-Side, Overlay, & Unified Diff Views</li>
          <li class="flex items-center gap-2">✓ Formula difference inspection (`=SUM(...)`)</li>
          <li class="flex items-center gap-2">✓ Click cell to add custom notes & audit flags</li>
        </ul>
        <div>
          <a href="/compare" class="btn-secondary text-xs py-2 px-6">TRY FILE DIFF →</a>
        </div>
      </div>

      <!-- Mode 2: Compare Columns -->
      <div class="card-bugatti bg-[#0d0d0d] space-y-6">
        <div class="flex items-center justify-between border-b border-[#262626] pb-4">
          <span class="text-caption text-[#c3d9f3]">MODE 02</span>
          <span class="text-xs font-mono text-[#999999]">SET LOGIC</span>
        </div>
        <h3 class="text-display-sm text-white">COLUMN SET COMPARISON</h3>
        <p class="font-serif text-[#cccccc] text-base leading-relaxed">
          Perform mathematical set operations on list columns. Instantly isolate common intersection values, unique left values, and unique right values without row noise.
        </p>
        <ul class="space-y-2 font-mono text-xs text-[#999999]">
          <li class="flex items-center gap-2">✓ Instant set intersection calculation</li>
          <li class="flex items-center gap-2">✓ Single-click CSV export per set breakdown</li>
          <li class="flex items-center gap-2">✓ Quick search & filter across datasets</li>
        </ul>
        <div>
          <a href="/compare-columns" class="btn-secondary text-xs py-2 px-6">TRY COLUMN COMPARISON →</a>
        </div>
      </div>

      <!-- Mode 3: Reconcile -->
      <div class="card-bugatti bg-[#0d0d0d] space-y-6">
        <div class="flex items-center justify-between border-b border-[#262626] pb-4">
          <span class="text-caption text-[#c3d9f3]">MODE 03</span>
          <span class="text-xs font-mono text-[#999999]">KEY-VALUE AUDIT</span>
        </div>
        <h3 class="text-display-sm text-white">ID-BASED DATA RECONCILIATION</h3>
        <p class="font-serif text-[#cccccc] text-base leading-relaxed">
          Select primary key columns (e.g. SKU, Employee ID, Account Code) and target value columns. Reconcile records across sheets regardless of row order or sorting differences.
        </p>
        <ul class="space-y-2 font-mono text-xs text-[#999999]">
          <li class="flex items-center gap-2">✓ Key-based mismatch detection</li>
          <li class="flex items-center gap-2">✓ Filter by Exact Match, Mismatch, Left Only, Right Only</li>
          <li class="flex items-center gap-2">✓ Audit-ready reconciliation report CSV</li>
        </ul>
        <div>
          <a href="/reconcile" class="btn-secondary text-xs py-2 px-6">TRY RECONCILIATION →</a>
        </div>
      </div>

      <!-- Mode 4: Batch Processing -->
      <div class="card-bugatti bg-[#0d0d0d] space-y-6">
        <div class="flex items-center justify-between border-b border-[#262626] pb-4">
          <span class="text-caption text-[#c3d9f3]">MODE 04</span>
          <span class="text-xs font-mono text-[#c3d9f3]">POWER TOOL</span>
        </div>
        <h3 class="text-display-sm text-white">BATCH FILE QUEUE ENGINE</h3>
        <p class="font-serif text-[#cccccc] text-base leading-relaxed">
          Queue multiple pairs of spreadsheets and process them all in a single automated batch run. Generate consolidated audit summary logs across entire workbooks.
        </p>
        <ul class="space-y-2 font-mono text-xs text-[#999999]">
          <li class="flex items-center gap-2">✓ Multi-file pair queueing</li>
          <li class="flex items-center gap-2">✓ Automated batch diff calculation</li>
          <li class="flex items-center gap-2">✓ Download aggregated batch report CSV</li>
        </ul>
        <div>
          <a href="/batch" class="btn-secondary text-xs py-2 px-6">TRY BATCH QUEUE →</a>
        </div>
      </div>
    </div>
  </div>
</section>
