---
import { t } from '../../utils/translations';
import type { Locale } from '../../config';
import { getLocalizedPathname } from '../../config';

interface Props {
  lang?: Locale;
}

const { lang: propLang = 'en' } = Astro.props;
const lang = propLang as Locale;
const localizedHref = (href: string) => getLocalizedPathname(lang, href);
---

<section class="py-24 bg-canvas border-b border-hairline">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-4 mb-16">
      <div class="text-caption text-link">{t(lang, 'featureGrid.archHeading', 'ARCHITECTURE & MODES')}</div>
      <h2 class="text-display-lg">{t(lang, 'featureGrid.archTitle', 'FOUR MODES FOR EVERY SPREADSHEET WORKFLOW')}</h2>
      <p class="font-serif text-lg text-muted max-w-2xl mx-auto">
        {t(lang, 'featureGrid.archDesc', 'Tailored algorithms built specifically for financial audits, inventory reconciliation, list set logic, and batch processing.')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Mode 1: Compare Files -->
      <div class="card-bugatti bg-surface-soft space-y-6">
        <div class="flex items-center justify-between border-b border-hairline pb-4">
          <span class="text-caption text-link">MODE 01</span>
          <span class="text-xs font-mono text-success">★ FEATURED</span>
        </div>
        <h3 class="text-display-sm text-ink">{t(lang, 'featureGrid.mode1Title', 'VISUAL FILE DIFF & SYNC SCROLL')}</h3>
        <p class="font-serif text-body text-base leading-relaxed">
          {t(lang, 'featureGrid.mode1Desc', 'Full sheet comparison with lockstep synchronized scrolling. Detect modified cells, inserted rows, deleted rows, and altered formulas with dark-tailored high-visibility diff highlights.')}
        </p>
        <ul class="space-y-2 font-mono text-xs text-muted">
          <li class="flex items-center gap-2">✓ Side-by-Side, Overlay, & Unified Diff Views</li>
          <li class="flex items-center gap-2">✓ Formula difference inspection (`=SUM(...)`)</li>
          <li class="flex items-center gap-2">✓ Click cell to add custom notes & audit flags</li>
        </ul>
        <div>
          <a href={localizedHref('/compare')} class="btn-secondary text-xs py-2 px-6">
            {t(lang, 'featureGrid.mode1Btn', 'TRY FILE DIFF →')}
          </a>
        </div>
      </div>

      <!-- Mode 2: Compare Columns -->
      <div class="card-bugatti bg-surface-soft space-y-6">
        <div class="flex items-center justify-between border-b border-hairline pb-4">
          <span class="text-caption text-link">MODE 02</span>
          <span class="text-xs font-mono text-muted">SET LOGIC</span>
        </div>
        <h3 class="text-display-sm text-ink">{t(lang, 'featureGrid.mode2Title', 'COLUMN SET COMPARISON')}</h3>
        <p class="font-serif text-body text-base leading-relaxed">
          {t(lang, 'featureGrid.mode2Desc', 'Perform mathematical set operations on list columns. Instantly isolate common intersection values, unique left values, and unique right values without row noise.')}
        </p>
        <ul class="space-y-2 font-mono text-xs text-muted">
          <li class="flex items-center gap-2">✓ Instant set intersection calculation</li>
          <li class="flex items-center gap-2">✓ Single-click CSV export per set breakdown</li>
          <li class="flex items-center gap-2">✓ Quick search & filter across datasets</li>
        </ul>
        <div>
          <a href={localizedHref('/compare-columns')} class="btn-secondary text-xs py-2 px-6">
            {t(lang, 'featureGrid.mode2Btn', 'TRY COLUMN COMPARISON →')}
          </a>
        </div>
      </div>

      <!-- Mode 3: Reconcile -->
      <div class="card-bugatti bg-surface-soft space-y-6">
        <div class="flex items-center justify-between border-b border-hairline pb-4">
          <span class="text-caption text-link">MODE 03</span>
          <span class="text-xs font-mono text-muted">KEY-VALUE AUDIT</span>
        </div>
        <h3 class="text-display-sm text-ink">{t(lang, 'featureGrid.mode3Title', 'ID-BASED DATA RECONCILIATION')}</h3>
        <p class="font-serif text-body text-base leading-relaxed">
          {t(lang, 'featureGrid.mode3Desc', 'Select primary key columns (e.g. SKU, Employee ID, Account Code) and target value columns. Reconcile records across sheets regardless of row order or sorting differences.')}
        </p>
        <ul class="space-y-2 font-mono text-xs text-muted">
          <li class="flex items-center gap-2">✓ Key-based mismatch detection</li>
          <li class="flex items-center gap-2">✓ Filter by Exact Match, Mismatch, Left Only, Right Only</li>
          <li class="flex items-center gap-2">✓ Audit-ready reconciliation report CSV</li>
        </ul>
        <div>
          <a href={localizedHref('/reconcile')} class="btn-secondary text-xs py-2 px-6">
            {t(lang, 'featureGrid.mode3Btn', 'TRY RECONCILIATION →')}
          </a>
        </div>
      </div>

      <!-- Mode 4: Batch Processing -->
      <div class="card-bugatti bg-surface-soft space-y-6">
        <div class="flex items-center justify-between border-b border-hairline pb-4">
          <span class="text-caption text-link">MODE 04</span>
          <span class="text-xs font-mono text-link">POWER TOOL</span>
        </div>
        <h3 class="text-display-sm text-ink">{t(lang, 'featureGrid.mode4Title', 'BATCH FILE QUEUE ENGINE')}</h3>
        <p class="font-serif text-body text-base leading-relaxed">
          {t(lang, 'featureGrid.mode4Desc', 'Queue multiple pairs of spreadsheets and process them all in a single automated batch run. Generate consolidated audit summary logs across entire workbooks.')}
        </p>
        <ul class="space-y-2 font-mono text-xs text-muted">
          <li class="flex items-center gap-2">✓ Multi-file pair queueing</li>
          <li class="flex items-center gap-2">✓ Automated batch diff calculation</li>
          <li class="flex items-center gap-2">✓ Download aggregated batch report CSV</li>
        </ul>
        <div>
          <a href={localizedHref('/batch')} class="btn-secondary text-xs py-2 px-6">
            {t(lang, 'featureGrid.mode4Btn', 'TRY BATCH QUEUE →')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
