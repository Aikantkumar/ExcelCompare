---
import { t } from '../../utils/translations';
import type { Locale } from '../../config';
import { localizeHref } from '../../utils/links';

interface Props {
  lang?: Locale;
}

const { lang: propLang = 'en' } = Astro.props;
const lang = propLang as Locale;
const localizedHref = (href: string) => localizeHref(lang, href);
---

<section class="relative bg-canvas text-ink pt-6 sm:pt-8 pb-8 sm:pb-12 border-b border-hairline">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5 sm:space-y-6 relative z-10">

    <!-- Main Headline and Sub-headline -->
    <div class="text-center">
      <h1 class="text-display-xl max-w-5xl mx-auto leading-tight">
        {t(lang, 'hero.headline', 'HIGH PRECISE EXCEL SPREADSHEET DIFFERENTIAL ENGINE')}
      </h1>

      <p class="font-serif text-xl sm:text-2xl text-body max-w-3xl mx-auto leading-relaxed">
        {t(lang, 'hero.subheadline', 'Compare Excel files cell-by-cell with formula awareness, smart fuzzy row alignment, cell annotations, and instant audit exports — all processed strictly inside your local browser.')}
      </p>
    </div>

    <!-- PART B: hero-stage with exactly 3 children -->
    <div class="hero-stage">
      <!-- 1) LEFT: four feature boxes -->
      <div class="hero-features">
        <div class="border border-hairline bg-surface-soft p-3 text-center">
          <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.formulaDiff', 'FORMULA DIFF')}</div>
          <div>{t(lang, 'hero.formulaDiffDesc', 'Compares Excel formulas, not just values')}</div>
        </div>
        <div class="border border-hairline bg-surface-soft p-3 text-center">
          <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.smartRowMatch', 'SMART ROW MATCH')}</div>
          <div>{t(lang, 'hero.smartRowMatchDesc', 'Fuzzy matches reordered rows')}</div>
        </div>
        <div class="border border-hairline bg-surface-soft p-3 text-center">
          <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.syncScroll', 'SYNC SCROLL')}</div>
          <div>{t(lang, 'hero.syncScrollDesc', 'Lockstep dual sheet scrolling')}</div>
        </div>
        <div class="border border-hairline bg-surface-soft p-3 text-center">
          <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.pdfHtmlExport', 'PDF & HTML EXPORT')}</div>
          <div>{t(lang, 'hero.pdfHtmlExportDesc', 'Auditable report generation')}</div>
        </div>
      </div>

      <!-- 2) CENTER: 5 scroll arrows -->
      <div class="scroll-arrows" aria-hidden="true">
        <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
        <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
        <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
        <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
        <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
      </div>

      <!-- 3) RIGHT: CTA buttons -->
      <div class="hero-ctas">
        <a href={localizedHref('/compare')} class="btn-primary text-center">
          {t(lang, 'hero.launchComparisonTool', 'LAUNCH COMPARISON TOOL')}
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* PART C: Scroll arrows, theme-aware */
  .scroll-arrows {
    --arrow-color: #ffffff;
    --glow-1: #ffffff;
    --glow-2: #ffffff;
    --glow-blur: 12px;
    --dim-opacity: 0.15;

    --arrow-width: 84px;
    --arrow-gap: 2px;
    --wave-speed: 1.8s;
    --wave-step: 0.18s;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--arrow-gap);
    pointer-events: none;
    margin-bottom: 2rem;
  }

  /* light theme: black arrows with black glow */
  :global(:root[data-theme="light"]) .scroll-arrows {
    --arrow-color: #000000;
    --glow-1: rgba(0, 0, 0, 0.65);
    --glow-2: rgba(0, 0, 0, 0.40);
    --glow-blur: 14px;
    --dim-opacity: 0.12;
  }

  .scroll-arrows svg {
    width: var(--arrow-width);
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--arrow-color);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: var(--dim-opacity);
    filter: drop-shadow(0 0 4px var(--glow-1)) drop-shadow(0 0 var(--glow-blur) var(--glow-2));
    animation: arrow-wave var(--wave-speed) ease-in-out infinite;
  }

  .scroll-arrows svg:nth-child(1) { animation-delay: calc(var(--wave-step) * 0); }
  .scroll-arrows svg:nth-child(2) { animation-delay: calc(var(--wave-step) * 1); }
  .scroll-arrows svg:nth-child(3) { animation-delay: calc(var(--wave-step) * 2); }
  .scroll-arrows svg:nth-child(4) { animation-delay: calc(var(--wave-step) * 3); }
  .scroll-arrows svg:nth-child(5) { animation-delay: calc(var(--wave-step) * 4); }

  @keyframes arrow-wave {
    0%   { opacity: var(--dim-opacity); }
    18%  { opacity: 1; }
    45%  { opacity: var(--dim-opacity); }
    100% { opacity: var(--dim-opacity); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrows svg { animation: none; opacity: 0.6; }
  }

  /* PART B: hero-stage grid layout */
  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto;
    align-items: center;
    column-gap: 4rem;
  }

  .hero-features {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.6rem;
    width: 100%;
    max-width: 26rem;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .hero-features > div {
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .hero-ctas {
    grid-column: 3;
    grid-row: 1;
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: max-content;
    min-width: 20rem;
    max-width: 100%;
  }

  .hero-ctas a {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    white-space: nowrap;
    min-width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrows svg { animation: none; opacity: 0.6; }
  }

  @media (max-width: 1023.98px) {
    .hero-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .hero-features {
      order: 3;
      width: max-content;
      max-width: 28rem;
    }

    .scroll-arrows {
      order: 1;
    }

    .hero-ctas {
      order: 2;
      width: 100%;
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }

    .hero-ctas a {
      white-space: normal;
      min-width: auto;
    }
  }
</style>