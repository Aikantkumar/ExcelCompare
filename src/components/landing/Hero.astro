---
import { t } from '../../utils/translations';
import type { Locale } from '../../config';
import { getLocalizedPathname } from '../../config';

interface Props {
  lang?: Locale;
}

const { lang: propLang = 'en' } = Astro.props;
const lang = propLang as Locale;
const localizedHref = (href: string) => getLocalizedPathname(lang, href);
---

<section class="relative bg-canvas text-ink pt-12 pb-16 sm:pt-20 sm:pb-28 border-b border-hairline">
  <!-- Subtle radial background lighting -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_-10%,color-mix(in_srgb,var(--color-link)_10%,transparent),transparent)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8 relative z-10">
    <!-- Brand Tag -->
    <div class="inline-flex items-center gap-2 border border-hairline-strong px-4 py-1.5 rounded-full text-caption text-link">
      <span class="w-2 h-2 bg-success rounded-full"></span>
      {t(lang, 'hero.offlineBadge', '100% OFFLINE BROWSER DIFF ENGINE')}
    </div>

    <!-- Main Headline in Saira Condensed display letterspaced uppercase -->
    <h1 class="text-display-xl max-w-5xl mx-auto leading-tight">
      {t(lang, 'hero.headline', 'HIGH PRECISE EXCEL SPREADSHEET DIFFERENTIAL ENGINE')}
    </h1>

    <!-- Sub-headline in Cormorant Garamond serif -->
    <p class="font-serif text-xl sm:text-2xl text-body max-w-3xl mx-auto leading-relaxed">
      {t(lang, 'hero.subheadline', 'Compare Excel files cell-by-cell with formula awareness, smart fuzzy row alignment, cell annotations, and instant audit exports — all processed strictly inside your local browser.')}
    </p>

    <style>
      .scroll-arrows {
        --arrow-color: #ffffff;
        --arrow-width: 84px;
        --arrow-gap: 2px;
        --wave-speed: 1.8s;
        --wave-step: 0.18s;

        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--arrow-gap);
        pointer-events: none;
        margin-top: 1rem;
      }

      .scroll-arrows svg {
        width: var(--arrow-width);
        height: auto;
        overflow: visible;
        fill: none;
        stroke: var(--arrow-color);
        stroke-width: 3.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.15;
        filter:
          drop-shadow(0 0 4px var(--arrow-color))
          drop-shadow(0 0 12px var(--arrow-color));
        animation: arrow-wave var(--wave-speed) ease-in-out infinite;
      }

      .scroll-arrows svg:nth-child(1) { animation-delay: calc(var(--wave-step) * 0); }
      .scroll-arrows svg:nth-child(2) { animation-delay: calc(var(--wave-step) * 1); }
      .scroll-arrows svg:nth-child(3) { animation-delay: calc(var(--wave-step) * 2); }
      .scroll-arrows svg:nth-child(4) { animation-delay: calc(var(--wave-step) * 3); }
      .scroll-arrows svg:nth-child(5) { animation-delay: calc(var(--wave-step) * 4); }

      @keyframes arrow-wave {
        0%   { opacity: 0.15; }
        18%  { opacity: 1; }
        45%  { opacity: 0.15; }
        100% { opacity: 0.15; }
      }

      @media (prefers-reduced-motion: reduce) {
        .scroll-arrows svg { animation: none; opacity: 0.6; }
      }
    </style>

    <div class="scroll-arrows" aria-hidden="true">
      <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
      <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
      <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
      <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
      <svg viewBox="0 0 100 34"><path d="M6 6 L50 28 L94 6"/></svg>
    </div>

    <!-- CTAs in Bugatti transparent pill buttons -->
    <div class="flex flex-wrap items-center justify-center gap-6 pt-4">
      <a href={localizedHref('/compare')} class="btn-primary">
        {t(lang, 'hero.launchComparisonTool', 'LAUNCH COMPARISON TOOL')}
      </a>
      <a href={localizedHref('/compare')} class="btn-secondary">
        {t(lang, 'hero.exploreCompetitorAdvantage', 'EXPLORE COMPETITOR ADVANTAGE')}
      </a>
    </div>

    <!-- Feature Quick Pills -->
    <div class="pt-12 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-caption text-muted">
      <div class="border border-hairline p-4 bg-surface-soft">
        <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.formulaDiff', 'FORMULA DIFF')}</div>
        <div>{t(lang, 'hero.formulaDiffDesc', 'Compares Excel formulas, not just values')}</div>
      </div>
      <div class="border border-hairline p-4 bg-surface-soft">
        <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.smartRowMatch', 'SMART ROW MATCH')}</div>
        <div>{t(lang, 'hero.smartRowMatchDesc', 'Fuzzy matches reordered rows')}</div>
      </div>
      <div class="border border-hairline p-4 bg-surface-soft">
        <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.syncScroll', 'SYNC SCROLL')}</div>
        <div>{t(lang, 'hero.syncScrollDesc', 'Lockstep dual sheet scrolling')}</div>
      </div>
      <div class="border border-hairline p-4 bg-surface-soft">
        <div class="text-ink font-mono text-sm mb-1">{t(lang, 'hero.pdfHtmlExport', 'PDF & HTML EXPORT')}</div>
        <div>{t(lang, 'hero.pdfHtmlExportDesc', 'Auditable report generation')}</div>
      </div>
    </div>
  </div>
</section>
