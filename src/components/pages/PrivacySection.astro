---
import { t } from '../../utils/translations';
import type { Locale } from '../../config';

interface Props {
  lang?: Locale;
}

const { lang: propLang = 'en' } = Astro.props;
const lang = propLang as Locale;
---

<div class="py-16 bg-canvas border-b border-hairline">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="text-center space-y-4">
      <div class="text-caption text-success">{t(lang, 'sections.privacy.badge', '100% LOCAL BROWSER DIFF GUARANTEE')}</div>
      <h1 class="text-display-lg text-ink">{t(lang, 'sections.privacy.title', 'YOUR SPREADSHEET DATA NEVER LEAVES YOUR DEVICE')}</h1>
    </div>

    <div class="border border-hairline bg-surface-soft p-8 space-y-6 font-serif text-body leading-relaxed">
      <h2 class="text-title-md text-ink font-mono">{t(lang, 'sections.privacy.archTitle', 'ZERO SERVER UPLOAD ARCHITECTURE')}</h2>
      <p>
        {t(lang, 'sections.privacy.archP1', 'At CompareExcel, we understand that financial reports, payroll sheets, supplier pricing lists, and audit files contain private, highly sensitive business data.')}
      </p>
      <p>
        {t(lang, 'sections.privacy.archP2', 'Unlike legacy cloud diff services that require uploading your .xlsx files to a remote server, CompareExcel performs 100% of its parsing, diff calculation, set matching, and report rendering locally inside your web browser using JavaScript Web Workers and SheetJS.')}
      </p>

      <h2 class="text-title-md text-white font-mono">{t(lang, 'sections.privacy.techTitle', 'TECHNICAL VERIFICATION')}</h2>
      <ul class="list-disc pl-6 space-y-2 font-mono text-xs text-muted">
        <li>{t(lang, 'sections.privacy.tech1', 'Open Network DevTools: No HTTP POST or file upload requests occur when loading or diffing spreadsheets.')}</li>
        <li>{t(lang, 'sections.privacy.tech2', 'Works Offline: Once the page is loaded, you can disconnect your internet entirely and continue diffing files offline.')}</li>
        <li>{t(lang, 'sections.privacy.tech3', 'No Third-Party Data Selling or Analytics on Spreadsheet Contents.')}</li>
      </ul>
    </div>
  </div>
</div>
