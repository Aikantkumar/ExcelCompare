---
import Hero from '../landing/Hero.astro';
import FeatureGrid from '../landing/FeatureGrid.astro';
import CompetitorComparison from '../landing/CompetitorComparison.astro';
import CompareToolContainer from '../comparison/CompareToolContainer.jsx';
import { getLocalizedPathname } from '../../config';
import { t } from '../../utils/translations';
import type { Locale } from '../../config';

interface Props {
  lang?: Locale;
}

const { lang: propLang = 'en' } = Astro.props;
const lang = propLang as Locale;
const localizedHref = (href: string) => getLocalizedPathname(lang, href);
---

<!-- Hero Section -->
<Hero lang={lang} />

<!-- Main Interactive Comparison Tool Workspace -->
<section class="py-12 bg-canvas border-b border-hairline">
  <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 mb-4 text-center">
    <div class="text-caption text-link">{t(lang, 'common.interactiveWorkspace', 'INTERACTIVE WORKSPACE')}</div>
    <h2 class="text-display-md text-ink mt-1">{t(lang, 'common.testLiveEngine', 'TEST LIVE SPREADSHEET DIFFERENTIAL ENGINE')}</h2>
  </div>
  <CompareToolContainer client:only="react" initialMode="files" locale={lang} />
</section>

<!-- Feature Grid Section -->
<FeatureGrid lang={lang} />

<!-- Competitor Advantage Matrix Section -->
<CompetitorComparison lang={lang} />

<!-- CTA Band -->
<section class="py-24 bg-canvas text-center border-b border-hairline">
  <div class="max-w-4xl mx-auto px-4 space-y-6">
    <div class="text-caption text-link">{t(lang, 'common.engineeredForAccuracy', 'ENGINEERED FOR ACCURACY & PRIVACY')}</div>
    <h2 class="text-display-lg text-ink">{t(lang, 'common.readyForAudit', 'READY TO RUN YOUR SPREADSHEET AUDIT?')}</h2>
    <p class="font-serif text-lg text-muted max-w-xl mx-auto leading-relaxed">
      {t(lang, 'common.noSignUp', 'No sign up, no credit card, no software installation required. Drop your files and get instant visual diffs inside your local browser.')}
    </p>
    <div class="pt-4">
      <a href={localizedHref('/compare')} class="btn-primary">
        {t(lang, 'common.openComparisonWorkspace', 'OPEN COMPARISON WORKSPACE NOW')}
      </a>
    </div>
  </div>
</section>

<!-- SEO Content: Comprehensive Tool Guide -->
<section class="py-24 bg-canvas border-b border-hairline">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-caption text-link text-center mb-6">{t(lang, 'common.aboutTheTool', 'ABOUT THE TOOL')}</div>
    <h2 class="text-display-lg text-ink text-center mb-12" set:html={t(lang, 'sections.index.seoTitle', 'CompareExcel — The Online Excel Compare Columns & Spreadsheet Comparison Solution')} />
    <div class="prose prose-invert max-w-none text-body font-serif leading-relaxed text-base space-y-8">
      <p set:html={t(lang, 'sections.index.seoAbout', 'When you need to <strong>excel compare columns</strong> across two workbooks, find matching values, or spot differences between sheets, CompareExcel gives you a fast, private, browser-based engine that runs entirely on your device. Whether you are a finance analyst reconciling ledgers, an operations manager checking inventory SKUs, or a data auditor validating customer lists, our online Excel compare tool lets you upload two files, run a cell-by-cell diff, and review every change — all without sending your data to a remote server.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoColsTitle', 'What Does It Mean to Excel Compare Columns?')} />
      <p set:html={t(lang, 'sections.index.seoCols', 'To <strong>excel compare columns</strong> means taking one column from File A and one column from File B and determining which values exist in both, which appear only on the left, and which appear only on the right. CompareExcel performs this set logic instantly. You can isolate the <strong>excel compare two columns for matches</strong> (the intersection), the <strong>excel compare two columns for differences</strong> (unique values), and export each result as a clean CSV for downstream reporting.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoMatchesTitle', 'Excel Compare Two Columns for Matches and Differences')} />
      <p set:html={t(lang, 'sections.index.seoMatches', 'Many users arrive looking to <strong>excel compare two columns for matches</strong> — for example, verifying that a new subscriber list overlaps with a master CRM export. Others need to <strong>excel compare two columns for differences</strong>, such as identifying product SKUs that were removed from a price sheet. Our column set comparison mode handles both cases with a single click, showing intersection, left-only, and right-only values side by side.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoSheetsTitle', 'Excel Compare Two Sheets, Two Files, and Two Cells')} />
      <p set:html={t(lang, 'sections.index.seoSheets', 'Beyond columns, CompareExcel supports <strong>excel compare two sheets</strong> within the same workbook or across separate files. Our <strong>excel compare two files</strong> mode parses both spreadsheets locally using SheetJS Web Workers, then renders a synchronized, color-coded diff grid. If you only need to <strong>excel compare two cells</strong> — for example, confirming that a single calculated value did not drift between versions — the cell-level inspector highlights exact value and formula changes at the individual cell level.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoDatesTitle', 'Excel Compare Dates and Two Lists')} />
      <p set:html={t(lang, 'sections.index.seoDates', 'Working with time-series data? Our engine treats date cells as first-class values, so you can <strong>excel compare dates</strong> across columns and flag shifted or mismatched timestamps. Likewise, if you are reconciling mailing lists, part numbers, or account codes, the <strong>excel compare two lists</strong> workflow uses fuzzy row matching to align records even when sort order differs between files.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoWhyTitle', 'Why Choose an Online Excel Compare Tool?')} />
      <p set:html={t(lang, 'sections.index.seoWhy', 'Traditional desktop methods require complex formulas, VLOOKUP helper columns, or manual sorting. An <strong>online excel compare</strong> utility like CompareExcel removes that friction. There is no software to install, no account to create, and no file size limit that blocks your audit. Because processing happens client-side, sensitive financial records, payroll sheets, and supplier pricing never leave your browser — a critical advantage over cloud diff services that upload your .xlsx files to third-party servers.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoCapsTitle', 'Key Capabilities of the Excel Comparison Engine')} />
      <ul class="list-disc pl-6 space-y-3 text-body font-serif">
        <li set:html={t(lang, 'sections.index.seoCaps1', '<strong>Cell-by-cell diff</strong> — Every changed, added, or deleted cell is color-coded (amber for modified, green for added, red for deleted).')} />
        <li set:html={t(lang, 'sections.index.seoCaps2', '<strong>Formula inspection</strong> — We compare underlying Excel formulas, not just displayed values, so <code>=SUM(A1:A10)</code> vs <code>=SUM(A1:A9)</code> is caught immediately.')} />
        <li set:html={t(lang, 'sections.index.seoCaps3', '<strong>Smart fuzzy row matching</strong> — Inserted or reordered rows do not cascade into false positives; our algorithm aligns rows by content signature.')} />
        <li set:html={t(lang, 'sections.index.seoCaps4', '<strong>Synchronized scrolling</strong> — Lockstep navigation across both sheets keeps related rows in view simultaneously.')} />
        <li set:html={t(lang, 'sections.index.seoCaps5', '<strong>Cell annotations</strong> — Click any diff cell to add audit notes, then export the annotated report.')} />
        <li set:html={t(lang, 'sections.index.seoCaps6', '<strong>Export options</strong> — Download printable HTML reports, CSV breakdowns, or generate shareable links.')} />
        <li set:html={t(lang, 'sections.index.seoCaps7', '<strong>Batch queue</strong> — Process multiple file pairs in one automated run with a consolidated summary log.')} />
      </ul>
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoUseTitle', 'Common Use Cases for Excel Compare Columns')} />
      <p set:html={t(lang, 'sections.index.seoUse', 'Finance teams use CompareExcel to <strong>excel compare two columns</strong> in monthly close workbooks, catching variance before it hits the general ledger. Supply chain analysts run <strong>excel compare two sheets</strong> to confirm inbound purchase orders against received goods. HR professionals <strong>excel compare two lists</strong> of employee IDs across systems to surface headcount discrepancies. IT auditors use <strong>excel compare dates</strong> to verify change logs and system timestamps. Whatever your scenario, if your task involves <strong>excel compare columns</strong> or broader spreadsheet diffing, this tool is built for it.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoPrivTitle', 'Privacy-First Online Excel Compare')} />
      <p set:html={t(lang, 'sections.index.seoPriv', 'Unlike many <strong>online excel compare</strong> services, CompareExcel does not store your files. Parsing, diff calculation, and rendering all occur inside Web Workers on your machine. You can disconnect from the internet after loading the page and continue comparing spreadsheets offline. Network DevTools confirms zero HTTP upload requests when you load or diff workbooks, making this suitable for confidential business data.')} />
      <h3 class="text-title-md text-ink mt-8 mb-4" set:html={t(lang, 'sections.index.seoStartTitle', 'Get Started with CompareExcel Today')} />
      <p set:html={t(lang, 'sections.index.seoStart', 'Ready to <strong>excel compare columns</strong>, <strong>excel compare two sheets</strong>, or run a full <strong>excel compare two files</strong> audit? Open the comparison workspace, drop your workbooks, and review instant visual diffs in your local browser. No sign-up, no credit card, and no installation required — just accurate, private spreadsheet comparison whenever you need it.')} />
    </div>
  </div>
</section>
